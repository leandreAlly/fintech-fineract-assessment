+
+        GLAccountExternalIdConflictException conflict = assertThrows(GLAccountExternalIdConflictException.class,
+                () -> service.syncGLAccount(command(payload("Loans Receivable"))));
+
+        assertEquals(EXTERNAL_ID, conflict.getExternalId());
+        assertEquals(EXISTING_ID, conflict.getExistingGlAccountId());
+        verify(glAccountRepository, never()).saveAndFlush(any());
+    }
+
+    @Test
+    void rejectsMissingExternalId() {
+        JsonObject payload = payload("Loan Receivable");
+        payload.remove("externalId");
+
+        assertThrows(PlatformApiDataValidationException.class, () -> service.syncGLAccount(command(payload)));
+        verify(glAccountRepository, never()).saveAndFlush(any());
+    }
+
+    @Test
+    void rejectsGlCodeAlreadyUsedByAnotherAccount() {
+        when(glAccountRepository.findByExternalId(new ExternalId(EXTERNAL_ID))).thenReturn(Optional.empty());
+        when(glAccountRepository.findOneByGlCode("1200")).thenReturn(Optional.of(new GLAccount().setGlCode("1200")));
+
+        assertThrows(GLAccountDuplicateException.class, () -> service.syncGLAccount(command(payload("Loan Receivable"))));
+        verify(glAccountRepository, never()).saveAndFlush(any());
+    }
+
+    @Test
+    void turnsUniqueConstraintRaceIntoRetryableConcurrencyFailure() {
+        when(glAccountRepository.findByExternalId(new ExternalId(EXTERNAL_ID))).thenReturn(Optional.empty());
+        when(glAccountRepository.findOneByGlCode("1200")).thenReturn(Optional.empty());
+        when(glAccountRepository.saveAndFlush(any())).thenThrow(new DataIntegrityViolationException("acc_gl_account_external_id_key"));
+
+        assertThrows(ConcurrencyFailureException.class, () -> service.syncGLAccount(command(payload("Loan Receivable"))));
+    }
+
+    private JsonObject payload(String name) {
+        JsonObject payload = new JsonObject();
+        payload.addProperty("externalId", EXTERNAL_ID);
+        payload.addProperty("name", name);
+        payload.addProperty("glCode", "1200");
+        payload.addProperty("type", 1);
+        payload.addProperty("usage", 1);
+        payload.addProperty("manualEntriesAllowed", true);
+        return payload;
+    }
+
+    private JsonCommand command(JsonObject payload) {
+        return JsonCommand.fromJsonElement(null, payload, fromJsonHelper);
+    }
+
+    private GLAccount existingAccount() {
+        GLAccount glAccount = new GLAccount().setName("Loan Receivable").setGlCode("1200").setType(1).setUsage(1)
+                .setManualEntriesAllowed(true).setExternalId(new ExternalId(EXTERNAL_ID));
+        glAccount.setId(EXISTING_ID);
+        return glAccount;
+    }
+}
