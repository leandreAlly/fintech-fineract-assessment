+        implements FineractExceptionMapper, ExceptionMapper<GLAccountExternalIdConflictException> {
+
+    @Override
+    public Response toResponse(final GLAccountExternalIdConflictException exception) {
+        log.warn("Exception occurred", ErrorHandler.findMostSpecificException(exception));
+        final ApiGlobalErrorResponse conflictError = ApiGlobalErrorResponse.create(Status.CONFLICT.getStatusCode(),
+                exception.getGlobalisationMessageCode(), exception.getDefaultUserMessage(), exception.getDefaultUserMessage(),
+                List.of(ApiParameterError.generalError(exception.getGlobalisationMessageCode(), exception.getDefaultUserMessage(),
+                        exception.getDefaultUserMessageArgs())));
+        return Response.status(Status.CONFLICT).entity(conflictError).type(MediaType.APPLICATION_JSON).build();
+    }
+
+    @Override
+    public int errorCode() {
+        return 4091;
+    }
+}
