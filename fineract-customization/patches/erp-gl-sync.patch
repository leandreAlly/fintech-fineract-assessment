+package org.apache.fineract.accounting.glaccount.exception;
+
+import lombok.Getter;
+import org.apache.fineract.infrastructure.core.exception.AbstractPlatformDomainRuleException;
+
+@Getter
+public class GLAccountExternalIdConflictException extends AbstractPlatformDomainRuleException {
+
+    private final String externalId;
+    private final Long existingGlAccountId;
+
+    public GLAccountExternalIdConflictException(final String externalId, final Long existingGlAccountId) {
+        super("error.msg.glaccount.externalid.conflict", "General Ledger Account with external id " + externalId + " already exists (id "
+                + existingGlAccountId + ") with a different payload", externalId, existingGlAccountId);
+        this.externalId = externalId;
+        this.existingGlAccountId = existingGlAccountId;
+    }
+}
