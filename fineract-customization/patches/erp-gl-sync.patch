+    @Transactional
+    @Override
+    public CommandProcessingResult syncGLAccount(final JsonCommand command) {
+        final GLAccountCommand accountCommand = this.fromApiJsonDeserializer.commandFromApiJson(command.json(), SYNC_PARAMETERS);
+        final String externalIdValue = command.stringValueOfParameterNamed(EXTERNAL_ID);
+        validateExternalId(externalIdValue);
+        accountCommand.validateForCreate();
+        final ExternalId externalId = new ExternalId(externalIdValue);
+
+        final Optional<GLAccount> existing = this.glAccountRepository.findByExternalId(externalId);
+        if (existing.isPresent()) {
+            final GLAccount glAccount = existing.get();
+            if (!isSamePayload(glAccount, accountCommand)) {
+                throw new GLAccountExternalIdConflictException(externalIdValue, glAccount.getId());
+            }
+            return syncResult(command, glAccount);
+        }
+
+        if (this.glAccountRepository.findOneByGlCode(accountCommand.glCode()).isPresent()) {
+            throw new GLAccountDuplicateException(accountCommand.glCode());
+        }
+
+        final GLAccount parentGLAccount = accountCommand.parentId() == null ? null : validateParentGLAccount(accountCommand.parentId());
+        final CodeValue glAccountTagType = accountCommand.tagId() == null ? null
+                : retrieveTagId(accountCommand.tagId(), GLAccountType.fromInt(accountCommand.type()));
+
+        try {
+            final GLAccount glAccount = GLAccount.fromJson(parentGLAccount, command, glAccountTagType).setExternalId(externalId);
+            this.glAccountRepository.saveAndFlush(glAccount);
+            glAccount.generateHierarchy();
+            this.glAccountRepository.saveAndFlush(glAccount);
+            return syncResult(command, glAccount);
+        } catch (final JpaSystemException | DataIntegrityViolationException dve) {
+            throw new ConcurrencyFailureException("Concurrent GL account sync for external id " + externalIdValue, dve);
+        }
+    }
+
+    static boolean isSamePayload(final GLAccount glAccount, final GLAccountCommand accountCommand) {
+        final Long parentId = glAccount.getParent() == null ? null : glAccount.getParent().getId();
+        final Long tagId = glAccount.getTagId() == null ? null : glAccount.getTagId().getId();
+        return Objects.equals(glAccount.getName(), accountCommand.name()) && Objects.equals(glAccount.getGlCode(), accountCommand.glCode())
+                && Objects.equals(glAccount.getType(), accountCommand.type())
+                && Objects.equals(glAccount.getUsage(), accountCommand.usage())
+                && glAccount.isManualEntriesAllowed() == Boolean.TRUE.equals(accountCommand.manualEntriesAllowed())
+                && glAccount.isDisabled() == Boolean.TRUE.equals(accountCommand.disabled())
+                && Objects.equals(glAccount.getDescription(), accountCommand.description())
+                && Objects.equals(parentId, accountCommand.parentId()) && Objects.equals(tagId, accountCommand.tagId());
+    }
+
+    private void validateExternalId(final String externalIdValue) {
